{
  "name": "lifepilot",
  "version": "0.1.0",
  "description": "LifePilot — personal AI coach",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 -t 30000 && env -u ELECTRON_RUN_AS_NODE ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "dev:renderer": "cd renderer && npm run dev",
    "build": "cd renderer && npm run build",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^41.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.lifepilot.app",
    "productName": "LifePilot",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**"
    ]
  }
}
